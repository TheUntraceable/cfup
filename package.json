{
  "name": "@theuntraceable/cfup",
  "version": "0.2.0",
  "description": "Add and remove Cloudflare Tunnel public hostnames from the command line",
  "license": "MIT",
  "type": "module",
  "keywords": ["cloudflare", "tunnel", "cloudflared", "dns", "cli"],
  "homepage": "https://github.com/TheUntraceable/cfup",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheUntraceable/cfup.git"
  },
  "bin": {
    "cfup": "./src/cli.ts"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "bun x --package typescript tsc --noEmit",
    "build": "bun build --compile ./src/cli.ts --outfile dist/cfup"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4"
  }
}
